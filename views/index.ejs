<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
        <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 text-white ">
<h1 class="pd-4 py-5 text-3xl">Create User</h1>

        <form action="/create" method="post">
            <input type="text" placeholder="username" name = "username" class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800 outline-none">
            <input type="text" type="email" placeholder="email" name = "email" class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800 outline-none" >
            <input type="text" type="password" placeholder="password" name = "password" class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800 outline-none">
            <input type="text" type="number" placeholder="age" name = "age" class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800 outline-none" >
            <input type="submit" value="Create User" class=" px-4 py-2 rounded-md bg-blue-500">

        </form>
    </div>
    
</body>
</html>